# Only the key for the AI you use is needed (pick it in config.toml → [ai] provider).
# Ollama runs on your Mac and needs no key.

# Claude (default):  https://console.anthropic.com/  (Settings → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI:  https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Gemini:  https://aistudio.google.com/apikey
# GEMINI_API_KEY=...